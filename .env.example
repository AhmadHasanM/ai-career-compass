# Salin ke .env lalu isi nilainya: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=compass
POSTGRES_PASSWORD=compass
POSTGRES_DB=compass
# Port di host (5433 agar tidak bentrok dengan Postgres lokal); di jaringan Docker tetap 5432
POSTGRES_PORT=5433
# DSN dipakai backend, ai-service, migrate, dan seeder (host "db" = nama service di Docker Compose)
DATABASE_URL=postgres://compass:compass@db:5432/compass?sslmode=disable

# --- Backend Go ---
BACKEND_PORT=8080
GIN_MODE=debug
# Token untuk endpoint /api/admin/* (header X-Admin-Token)
ADMIN_TOKEN=change-me-admin
# Origin frontend yang diizinkan CORS
CORS_ORIGINS=http://localhost:3000

# --- Komunikasi internal backend <-> ai-service (header X-Internal-Token) ---
INTERNAL_TOKEN=change-me-internal
AI_SERVICE_URL=http://ai-service:8000

# --- LLM via OpenCode (endpoint OpenAI-compatible) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Embedding ---
# "api" = lewat endpoint OpenAI-compatible, "local" = intfloat/multilingual-e5-base
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# --- Langfuse (opsional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
